// ======== Helpers ========
string normalize(string s) {

	for (auto& c : s) {

		c = tolower(c);
	}
	return s;
}

// ======== USER ========

class usernode {
public:
	string username, password;
	int age;
	usernode* next;
	usernode(string u, string p, int a = 0) {
		username = u; password = p; age = a; next = nullptr;
	}
};

class usermanger {
	usernode* head;
	string filename = "usersdata.txt";
public:
	usermanger() { head = nullptr; loaduser(); }
	~usermanger() {
		saveusers();
		while (head) { usernode* t = head; head = head->next; delete t; }
	}

	void loaduser() {
		ifstream file(filename);
		if (!file.is_open()) return;
		string line;
		while (getline(file, line)) {
			if (line.empty()) continue;
			stringstream ss(line);
			string u, p, a;
			if (!getline(ss, u, ',')) continue;
			if (!getline(ss, p, ',')) continue;
			if (!getline(ss, a)) continue;
			// skip lines that don't have a valid age number
			bool validAge = !a.empty();
			for (char c : a) if (!isdigit(c)) { validAge = false; break; }
			if (!validAge) continue;
			int age = stoi(a);
			usernode* n = new usernode(u, p, age);
			n->next = head; head = n;
		}
	}

	void saveusers() {
		ofstream file(filename);
		for (usernode* c = head; c; c = c->next)
			file << c->username << "," << c->password << "," << c->age << endl;
	}

	void signin(string u, string p, int a) {
		// username must be unique — password can be repeated across users
		for (usernode* c = head; c; c = c->next)
			if (c->username == u) {
				cout << " Username already exists " << endl;
				return;
			}
		usernode* n = new usernode(u, p, a);
		n->next = head; head = n;
		saveusers();
		cout << "User created successfully !" << endl;
	}

	usernode* login(string u, string p) {
		for (usernode* c = head; c; c = c->next)
			if (c->username == u && c->password == p) {
				cout << "Login success!" << endl;
				return c;
			}
		cout << " Wrong Username Or Password" << endl;
		return nullptr;
	}
};

// ======== MOVIE ========
class Movie {
public:
	string name, desc, lang;
	int duration, ageRating;
	float rating;
	Movie* left, * right;
	string genre;

	Movie(string n, string d, int dur, int age, string lan, string gen = "general", double rat = 0.0) {
		name = n; desc = d; duration = dur; ageRating = age;
		lang = lan; genre = gen; rating = rat;
		left = right = nullptr;
	}
};

class RecentQueue
{

private:
	queue<Movie*> q;
	int maxSize;

public:

	RecentQueue(int maxR = 5) {
		maxSize = maxR;
	}

	void add(Movie* m) {
		q.push(m);
		if (q.size() > maxSize) {
			q.pop();
		}
	}
	void display() {
		if (q.empty()) {
			cout << " ❌ No recent movies." << endl;
			return;
		}
		cout << "  🔥 Recently Added Movies:" << endl;
		queue<Movie*> temp = q;
		while (!temp.empty()) {
			cout << temp.front()->name << endl;
			temp.pop();
		}

		cout << endl;
	}
};

class MovieBST {
public:
	Movie* root;
	MovieBST() { root = nullptr; }

	Movie* insertRec(Movie* node, Movie* m) {
		if (!node) return m;
		if (m->name < node->name) node->left = insertRec(node->left, m);
		else node->right = insertRec(node->right, m);
		return node;
	}

	void addMovie(const string& n, const string& d, int dur, int age,
		const string& lang, const string& gen = "general",
		double rat = 0.0, RecentQueue* recent = nullptr) {
		string normalizedLang = normalize(lang);
		Movie* newMovie = new Movie(n, d, dur, age, normalize(lang), gen, rat);
		root = insertRec(root, newMovie);
		if (recent) recent->add(newMovie);
	}

	Movie* dfsSearch(Movie* node, const string& nameN, vector<string>& visitLog) {
		if (!node) return nullptr;
		Movie* leftResult = dfsSearch(node->left, nameN, visitLog);
		if (leftResult) return leftResult;
		visitLog.push_back(node->name);
		if (normalize(node->name) == nameN) return node;
		return dfsSearch(node->right, nameN, visitLog);
	}

	Movie* searchByName(const string& name) {
		vector<string> visitLog;
		Movie* result = dfsSearch(root, normalize(name), visitLog);
		for (int i = 0; i < (int)visitLog.size(); i++) {
			cout << visitLog[i];
			if (i < (int)visitLog.size() - 1) cout << " -> ";
		}
		cout << endl;
		return result;
	}

	void collectAll(Movie* node, vector<Movie*>& arr) {
		if (!node) return;
		collectAll(node->left, arr);
		arr.push_back(node);
		collectAll(node->right, arr);
	}

	void mergeSort(vector<Movie*>& arr, int left, int right) {
		if (left >= right) return;
		int mid = left + (right - left) / 2;
		mergeSort(arr, left, mid);
		mergeSort(arr, mid + 1, right);
		mergeParts(arr, left, mid, right);
	}

	void mergeParts(vector<Movie*>& arr, int left, int mid, int right) {
		vector<Movie*> temp;
		int i = left, j = mid + 1;
		while (i <= mid && j <= right) {
			if (arr[i]->rating >= arr[j]->rating) temp.push_back(arr[i++]);
			else temp.push_back(arr[j++]);
		}
		while (i <= mid) temp.push_back(arr[i++]);
		while (j <= right) temp.push_back(arr[j++]);
		for (int k = 0; k < (int)temp.size(); k++) arr[left + k] = temp[k];
	}

	void displayByAgeAndLang(int userAge, string lang) {
		vector<Movie*> filtered;
		vector<Movie*> all;
		collectAll(root, all);

		string langN = normalize(lang);
		for (Movie* m : all) {
			if (m->ageRating <= userAge && normalize(m->lang) == langN)
				filtered.push_back(m);
		}

		if (filtered.empty()) { cout << "No movies found for your criteria  " << endl; return; }

		// Sort filtered results by movie rating using Merge Sort
		mergeSort(filtered, 0, (int)filtered.size() - 1);

		cout << "======= Movies (sorted by rating: highest first) =======" << endl;
		for (Movie* m : filtered) {
			cout << "🎬 Name        : " << m->name << endl;
			cout << "⭐ Rating      : " << m->rating << " / 5" << endl;
			cout << "⏳ Duration    : " << m->duration << " minutes" << endl;
			cout << "👨 Age Rating  : +" << m->ageRating << endl;
			cout << "🎭 Genre       : " << m->genre << endl;
			cout << "📝 Description : " << m->desc << endl;
			cout << "🌍 Language    : " << m->lang << endl;
			cout << "--------------------------------------------" << endl;
			cout << endl;
		}
	}

	void displayAllSortedByRating() {
		vector<Movie*> all;
		collectAll(root, all);
		if (all.empty()) { cout << "No movies available." << endl; return; }

		mergeSort(all, 0, (int)all.size() - 1);

		cout << "====== All Movies Sorted by Rating  ======" << endl;
		for (Movie* m : all) {
			cout << m->rating << "/5 | " << m->name << " (" << m->lang << ", " << m->genre << ")" << endl;
		}
	}
};

// ======== WATCHLIST ========
class WatchNode {
public:
	string name;
	WatchNode* next, * prev;
	WatchNode(string n) { name = n; next = prev = nullptr; }
};

class Watchlist {
	WatchNode* head, * tail;
public:
	Watchlist() { head = tail = nullptr; }

	void add(string n) {
		WatchNode* x = new WatchNode(n);
		if (!head)head = tail = x;
		else {
			tail->next = x;
			x->prev = tail;
			tail = x;
		}
		cout << "Added to ur Watchlist <3 " << endl;
	}
	void remove(string movieName) {
		WatchNode* cur = head;
		while (cur) {
			if (normalize(cur->name) == normalize(movieName)) {
				if (cur->prev) cur->prev->next = cur->next;
				else head = cur->next;
				if (cur->next) cur->next->prev = cur->prev;
				else tail = cur->prev;
				delete cur;
				cout << " --> " << movieName << " removed from watchlist !" << endl;
				return;
			}
			cur = cur->next;
		}
		cout << "Movie not found in watchlist." << endl;
	}

	void display() {

		if (!head) {
			cout << " Watchlist is empty  !!" << endl;
			return;
		}
		WatchNode* c = head;
		cout << "Your Watchlist    :     " << endl;
		while (c) {
			cout << c->name;
			if (c->next)
				cout << " -> ";
			c = c->next;
		}
		cout << " -> END " << endl;
	}
};

